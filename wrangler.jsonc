{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adinaforsberg",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only audio requests run the worker; everything else is served directly as static files.
    "run_worker_first": ["/audio/*"]
  },
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "adina-audio" }
  ]
}
